# Public URL of the storefront (used for CORS and password-reset links)
PUBLIC_BASE_URL=http://localhost:8080

# MongoDB database name (the connection string is set to the compose service)
MONGO_DB=LuxeCommerceDb

# REQUIRED: random string of at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

JWT_ISSUER=ECommerce.API
JWT_AUDIENCE=ECommerce.Client
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Seed demo catalog, users, coupons and orders on first start
SEED_ENABLED=true

# Upload limit in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# SMTP (leave blank to log emails to the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@safwan.store
SMTP_FROM_NAME=Safwan
SMTP_ENABLE_SSL=true

# Stripe (server-side only; never expose the secret key in Angular)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
