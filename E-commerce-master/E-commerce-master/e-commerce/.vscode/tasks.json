{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "android: start Metro",
      "type": "shell",
      "command": "npx react-native start",
      "options": { "cwd": "C:\\b" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "android: run on device (debug)",
      "type": "shell",
      "command": "npx react-native run-android",
      "options": { "cwd": "C:\\b" },
      "problemMatcher": []
    },
    {
      "label": "android: build release APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleRelease -PreactNativeArchitectures=arm64-v8a",
      "options": { "cwd": "C:\\b\\android" },
      "problemMatcher": []
    }
  ]
}
